<?php
/**
 * Diagnostico de permisos Laravel en cPanel (sin Composer).
 * Subir a public_html/plataformapie.arielhf.cl/ y abrir UNA vez.
 * BORRAR al terminar.
 */
$expectedToken = '__DIAG_TOKEN__';
$laravelRoot = '/home/arielhfc/apps_laravel/sistema_pie';
$probeFile = $laravelRoot . '/vendor/symfony/deprecation-contracts/function.php';

if (($_GET['token'] ?? '') !== $expectedToken) {
    http_response_code(403);
    header('Content-Type: text/plain; charset=utf-8');
    exit('Acceso denegado.');
}

header('Content-Type: text/plain; charset=utf-8');

function octalPerms(string $path): string
{
    if (!file_exists($path)) {
        return '----';
    }

    return substr(sprintf('%o', fileperms($path)), -4);
}

function line(string $label, string $value = ''): void
{
    echo str_pad($label . ':', 28) . $value . "\n";
}

echo "=== Diagnostico permisos Laravel ===\n\n";

line('PHP version', PHP_VERSION);
line('PHP SAPI', PHP_SAPI);
line('Script user', function_exists('get_current_user') ? get_current_user() : 'n/a');
line('Process UID', function_exists('posix_geteuid') ? (string) posix_geteuid() : 'n/a');
line('Process GID', function_exists('posix_getegid') ? (string) posix_getegid() : 'n/a');
line('open_basedir', ini_get('open_basedir') ?: '(vacio)');
line('Laravel root', $laravelRoot);
line('Archivo prueba', $probeFile);
echo "\n";

echo "-- Cadena de carpetas padre --\n";
$path = $probeFile;
while ($path !== '/' && $path !== '' && $path !== '.') {
    $exists = file_exists($path);
    $type = $exists ? (is_dir($path) ? 'dir ' : 'file') : 'miss';
    $owner = $exists && function_exists('fileowner') ? (string) fileowner($path) : '-';
    $group = $exists && function_exists('filegroup') ? (string) filegroup($path) : '-';
    $readable = $exists && is_readable($path) ? 'yes' : 'no';
    $executable = $exists && is_executable($path) ? 'yes' : 'no';

    echo sprintf(
        "%s | %s | perm %s | owner %s | group %s | read %s | exec %s\n",
        $type,
        $path,
        octalPerms($path),
        $owner,
        $group,
        $readable,
        $executable
    );

    $parent = dirname($path);
    if ($parent === $path) {
        break;
    }
    $path = $parent;
}

echo "\n-- Prueba de lectura --\n";
line('file_exists', file_exists($probeFile) ? 'yes' : 'no');
line('is_readable', is_readable($probeFile) ? 'yes' : 'no');
line('is_file', is_file($probeFile) ? 'yes' : 'no');
line('filesize', file_exists($probeFile) ? (string) filesize($probeFile) : 'n/a');

if (is_readable($probeFile)) {
    $sample = @file_get_contents($probeFile, false, null, 0, 40);
    line('lectura OK', $sample !== false ? 'yes' : 'no');
} else {
    line('lectura OK', 'no');
}

echo "\n-- Autoload --\n";
$autoload = $laravelRoot . '/vendor/autoload.php';
line('autoload existe', file_exists($autoload) ? 'yes' : 'no');
line('autoload legible', is_readable($autoload) ? 'yes' : 'no');

if (is_readable($autoload)) {
    try {
        require $autoload;
        line('require autoload', 'OK');
    } catch (Throwable $e) {
        line('require autoload', 'ERROR: ' . $e->getMessage());
    }
}

echo "\n-- Interpretacion --\n";
if (!file_exists($probeFile)) {
    echo "- El archivo no existe: vendor incompleto o ruta Laravel incorrecta.\n";
} elseif (!is_readable($probeFile)) {
    echo "- Existe pero no es legible: revisar permisos Y propietario de toda la cadena.\n";
    echo "- En cPanel, la carpeta apps_laravel tambien debe ser transitable (755).\n";
    echo "- Si owner no coincide con tu usuario, chmod manual no alcanza: usa Composer de cPanel o re-sube vendor por FTP.\n";
} else {
    echo "- El archivo de prueba es legible. Si el sitio sigue fallando, limpia cache del navegador y revisa index.php.\n";
}

echo "\nElimina diagnose-permissions-cpanel.php del servidor.\n";
